{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarn",
  "version": "0.1.1",
  "identifier": "app.tarn.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/fetch-ytdlp.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-ytdlp.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tarn",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "theme": "Dark",
        "label": "main",
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob: asset: http://asset.localhost; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQjk2QjZDRjE3M0U0MTQKUldRVTVIUHhiR3U1NFZRditOcUoyWHlob3F0cWwycmg4eGZPODlyOEtVSDk5UmRDRkl3M0x1bksK",
      "endpoints": [
        "https://github.com/rexsystems/tarn/releases/latest/download/latest.json"
      ]
    }
  }
}
